# Microsoft Foundry (Azure OpenAI compatible endpoint). No API keys: auth uses Entra ID.
# Sign in first with: az login
FOUNDRY_ENDPOINT=https://<your-resource>.openai.azure.com/
FOUNDRY_DEPLOYMENT=<your-deployment-name>
FOUNDRY_API_VERSION=2025-04-01-preview

# AirLLM (Hugging Face model id or local path)
# On macOS only Llama architecture models work (MLX)
AIRLLM_MODEL=unsloth/Llama-3.3-70B-Instruct
# Only needed for gated models, the unsloth mirror is not gated
HF_TOKEN=

# Cost assumptions for the report (per 1M tokens, in the currency below, from your own price sheet)
FOUNDRY_PRICE_CURRENCY=USD
FOUNDRY_PRICE_INPUT_PER_1M=0.71
FOUNDRY_PRICE_CACHED_INPUT_PER_1M=0.71
FOUNDRY_PRICE_OUTPUT_PER_1M=0.71
# Prices above apply to rows whose model name contains this text, others get no cost line
# Llama 3.3 70B Global Standard, Azure Retail Prices API, Sweden Central, checked 2026-10-06
FOUNDRY_PRICE_MODEL=Llama
